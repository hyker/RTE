# Build artifacts
*.img
*.raw
*.qcow2
veritydata.txt
build.meta

# The custodes binary is regenerated by add-payload.sh (make clean && make build)
# before every image build, so the compiled artifact is never consumed from git.
payload/custodes/custodes

# Deployment secrets (CF_API_TOKEN)
secrets.sh

# Measurement metadata: the PROD .meta is tracked deliberately, so that the
# pinned measurements a client verifies against are publicly auditable.
# The dev values are local-only and change on every dev rebuild.
verity-dev-image.img.meta

# Local integrity pin for the Ubuntu cloud image (see build-base.sh).
ubuntu-cloudimg.sha256
